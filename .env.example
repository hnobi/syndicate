# Copy this file to .env and fill in real values. Never commit .env.

# --- Common
NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-string
EMAIL_USER=you@example.com
EMAIL_PASS=replace-with-app-password

# --- Database / cache
# Local (outside Docker): mongodb://localhost:27017/syndicatedb
# Docker Compose:         mongodb://admin:<MONGO_ROOT_PASSWORD>@mongodb:27017/syndicatedb?authSource=admin
MONGO_URL=mongodb://localhost:27017/syndicatedb
REDIS_HOST=localhost   # use "redis" when running via Docker Compose
REDIS_PORT=6379

# --- Docker Compose MongoDB container
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=replace-with-local-password
